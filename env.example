NODE_ENV=development

PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database config
DB_HOST=localhost
DB_PORT=5432
DB_EXT_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=portfolio_db

# Jwt config
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_HOURS=48

# Rag config
GROQ_API_KEY=
RAG_TOP_K=5

# Docker
# true runs compiled seeders once on container start, after migrations.
RUN_SEEDERS=false
DOCKER_IMAGE=johngomezdev/john-ish-api:latest